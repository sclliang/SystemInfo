#include <windows.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@PROJECT_VERSION_TWEAK@
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@PROJECT_VERSION_TWEAK@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "Author", "@SYSTEMINFO_AUTHOR@\0"
   VALUE "CompanyName", "@SYSTEMINFO_COMPANY@\0"
   VALUE "LegalCopyright", "@SYSTEMINFO_COPYRIGHT@\0"
   VALUE "FileDescription", "SystemInfo hardware collection core\0"
   VALUE "FileVersion", "@PROJECT_VERSION@\0"
   VALUE "ProductVersion", "@PROJECT_VERSION@\0"
   VALUE "InternalName", "SystemInfo.Native\0"
   VALUE "OriginalFilename", "SystemInfo.Native.dll\0"
   VALUE "ProductName", "SystemInfo\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
