#include <windows.h>
#pragma code_page(65001)
1 RT_MANIFEST "app.manifest"
101 ICON "six.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@PROJECT_VERSION_TWEAK@
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@PROJECT_VERSION_TWEAK@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "Author", "@SYSTEMINFO_AUTHOR@\0"
   VALUE "CompanyName", "@SYSTEMINFO_COMPANY@\0"
   VALUE "LegalCopyright", "@SYSTEMINFO_COPYRIGHT@\0"
   VALUE "FileDescription", "SystemInfo - Computer information\0"
   VALUE "FileVersion", "@PROJECT_VERSION@\0"
   VALUE "ProductVersion", "@PROJECT_VERSION@\0"
   VALUE "InternalName", "SystemInfo\0"
   VALUE "OriginalFilename", "SystemInfo.exe\0"
   VALUE "ProductName", "SystemInfo\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
