<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SystemInfo</AssemblyName>
    <RootNamespace>SystemInfo</RootNamespace>
    <Version>3.0.3</Version>
    <AssemblyVersion>3.0.3.0</AssemblyVersion>
    <FileVersion>3.0.3.0</FileVersion>
    <Authors>sclliang</Authors>
    <Company>sixunited</Company>
    <Copyright>Copyright (c) 2026 sixunited. Author: sclliang</Copyright>
    <Description>Windows computer information and diagnostics</Description>
    <NativeBuildDir Condition="'$(NativeBuildDir)' == ''">$(MSBuildThisFileDirectory)..\build\native-wpf</NativeBuildDir>
    <Win32Resource>$(NativeBuildDir)\SystemInfo.Wpf.res</Win32Resource>
    <NoWin32Manifest>true</NoWin32Manifest>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DebugType>portable</DebugType>
    <Obfuscate Condition="'$(Configuration)' == 'Release'">true</Obfuscate>
    <ConfuserProject>$(MSBuildThisFileDirectory)SystemInfo.crproj</ConfuserProject>
    <ConfuserReplaceOutput>true</ConfuserReplaceOutput>
    <CopyConfuserSymbolsMapToOutputDirectory>false</CopyConfuserSymbolsMapToOutputDirectory>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="Fody" Version="6.9.3" PrivateAssets="all" />
    <PackageReference Include="Costura.Fody" Version="6.2.0" PrivateAssets="all" />
    <PackageReference Include="Confuser.MSBuild" Version="1.6.0" PrivateAssets="all" />
    <Reference Include="System.Runtime.Serialization" />
    <EmbeddedResource Include="$(NativeBuildDir)\$(Configuration)\SystemInfo.Native.dll" LogicalName="SystemInfo.Native.dll" />
    <Resource Include="..\resources\SystemInfo.ico" Link="Assets\SystemInfo.ico" />
    <Resource Include="..\resources\SystemInfo.png" Link="Assets\SystemInfo.png" />
  </ItemGroup>
  <Target Name="BuildNativeCore" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipNativeBuild)' != 'true'">
    <Exec Command="cmake -S &quot;$(MSBuildThisFileDirectory)..&quot; -B &quot;$(NativeBuildDir)&quot; -A x64 -DBUILD_TESTING=ON -DSYSTEMINFO_REQUIRE_ADMIN=ON" />
    <Exec Command="cmake --build &quot;$(NativeBuildDir)&quot; --config $(Configuration) --target SystemInfoNative WpfResources --parallel" />
  </Target>
</Project>
