<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:vm="clr-namespace:SystemInfo.ViewModels">
  <BooleanToVisibilityConverter x:Key="VisibleIf" />
  <Style x:Key="Selectable" TargetType="TextBox">
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="IsReadOnlyCaretVisible" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="0" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <DataTemplate DataType="{x:Type vm:Readout}">
    <Grid Margin="0,6">
      <Grid.ColumnDefinitions><ColumnDefinition Width="83" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,1,9,0" TextWrapping="Wrap" />
      <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource Selectable}" AutomationProperties.Name="{Binding Label}" />
    </Grid>
  </DataTemplate>
  <DataTemplate DataType="{x:Type vm:Drive}">
    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14,12" Margin="0,4,0,7" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
      <StackPanel>
        <TextBox Text="{Binding Model, Mode=OneWay}" Style="{StaticResource Selectable}" FontWeight="SemiBold" FontSize="13" AutomationProperties.Name="SSD 型号" />
        <WrapPanel Margin="0,5,0,10">
          <TextBlock Text="{Binding Capacity}" FontSize="12" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,10,0" />
          <TextBlock Text="{Binding Protocol}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </WrapPanel>
        <ItemsControl ItemsSource="{Binding Metrics}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,3,8,5">
                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,0,0,3" />
                <TextBox Text="{Binding Value, Mode=OneWay}" Style="{StaticResource Selectable}" FontWeight="Medium" AutomationProperties.Name="{Binding Label}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
          <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Notes}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </Border>
  </DataTemplate>
  <DataTemplate DataType="{x:Type vm:Section}">
    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="11" Padding="20,17,20,15">
      <StackPanel>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Width="35" Height="35" VerticalAlignment="Top" Margin="0,0,11,0">
            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="19" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0" />
          </StackPanel>
        </Grid>
        <Border Background="{DynamicResource CardStrokeColorDefaultBrush}" Height="1" Margin="0,0,0,5" />
        <ItemsControl ItemsSource="{Binding Fields}">
          <ItemsControl.Style>
            <Style TargetType="ItemsControl"><Style.Triggers>
              <DataTrigger Binding="{Binding HasDrives}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers></Style>
          </ItemsControl.Style>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding Drives}" Visibility="{Binding HasDrives, Converter={StaticResource VisibleIf}}" Margin="0,5,0,0" />
        <StackPanel Visibility="{Binding HasPercent, Converter={StaticResource VisibleIf}}" Margin="0,9,0,9">
          <TextBlock Text="{Binding PercentText}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
          <ProgressBar Value="{Binding Battery.Percent, Mode=OneWay}" Maximum="100" Height="5" Margin="0,7,0,5" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Battery.Packs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,10,0,0">
                <TextBox Text="{Binding Name, Mode=OneWay}" Style="{StaticResource Selectable}" FontWeight="SemiBold" Margin="0,0,0,7" />
                <ItemsControl ItemsSource="{Binding Fields}">
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <Grid Margin="0,4">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition /></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                      <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource Selectable}" AutomationProperties.Name="{Binding Label}" />
                    </Grid>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </DataTemplate>
</ResourceDictionary>
