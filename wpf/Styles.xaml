<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:vm="clr-namespace:SystemInfo.ViewModels">
  <BooleanToVisibilityConverter x:Key="VisibleIf" />
  <Style x:Key="Selectable" TargetType="TextBox">
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="IsReadOnlyCaretVisible" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="0" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <DataTemplate DataType="{x:Type vm:Readout}">
    <Grid Margin="0,6">
      <Grid.ColumnDefinitions><ColumnDefinition Width="83" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,1,9,0" TextWrapping="Wrap" />
      <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource Selectable}" AutomationProperties.Name="{Binding Label}" />
    </Grid>
  </DataTemplate>
  <DataTemplate DataType="{x:Type vm:Section}">
      <StackPanel>
        <Grid Margin="0,0,0,11">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="18" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,9,0" />
          <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <Border Grid.Column="2" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Height="1" Margin="13,0,0,0" VerticalAlignment="Center" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Fields}" />
        <StackPanel Visibility="{Binding HasPercent, Converter={StaticResource VisibleIf}}" Margin="0,9,0,9">
          <TextBlock Text="{Binding PercentText}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
          <ProgressBar Value="{Binding Battery.Percent, Mode=OneWay}" Maximum="100" Height="5" Margin="0,7,0,5" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Battery.Packs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,10,0,0">
                <TextBox Text="{Binding Name, Mode=OneWay}" Style="{StaticResource Selectable}" FontWeight="SemiBold" Margin="0,0,0,7" />
                <ItemsControl ItemsSource="{Binding Fields}">
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <Grid Margin="0,4">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition /></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                      <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource Selectable}" AutomationProperties.Name="{Binding Label}" />
                    </Grid>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
  </DataTemplate>
</ResourceDictionary>
