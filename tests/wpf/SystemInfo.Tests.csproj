<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SystemInfo.Tests</AssemblyName>
    <Version>3.0.0</Version>
    <Authors>sclliang</Authors>
    <Company>sixunited</Company>
    <Copyright>Copyright (c) 2026 sixunited. Author: sclliang</Copyright>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <BaseOutputPath>..\..\build\wpf-tests\</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <Reference Include="System.Runtime.Serialization" />
    <Compile Include="..\..\wpf\Logic\Options.cs" Link="Options.cs" />
    <Compile Include="..\..\wpf\Models\Snapshot.cs" Link="Snapshot.cs" />
    <Compile Include="..\..\wpf\ViewModels\Dashboard.cs" Link="Dashboard.cs" />
  </ItemGroup>
</Project>
