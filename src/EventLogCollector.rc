#pragma code_page(65001)
#include "resource.h"
#include <winver.h>
#include <winuser.h>
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
IDI_APP ICON "../assets/six6.ico"
1 VERSIONINFO
 FILEVERSION 1,2,0,0
 PRODUCTVERSION 1,2,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "sixunited"
            VALUE "Author", "sclliang"
            VALUE "FileDescription", "Windows Event Log and Diagnostic Collector"
            VALUE "FileVersion", "1.2.0.0"
            VALUE "InternalName", "EventLogCollector"
            VALUE "LegalCopyright", "Copyright (c) 2026 sixunited. Author: sclliang"
            VALUE "OriginalFilename", "EventLogCollector.exe"
            VALUE "ProductName", "EventLogCollector"
            VALUE "ProductVersion", "1.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
